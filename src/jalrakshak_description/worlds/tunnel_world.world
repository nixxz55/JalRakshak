<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- Cylindrical Pipe Segment -->
    <model name="oval_pipe">
      <static>true</static>
      <pose>5 0 0.5 0 1.5707 0</pose>
      <link name="track_floor">
        <collision name="col">
          <geometry>
            <cylinder>
              <radius>0.8</radius>
              <length>20.0</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="vis">
          <geometry>
            <cylinder>
              <radius>0.8</radius>
              <length>20.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Clean Water Puddle on Floor at 8m (No hole in pipe) -->
    <model name="water_puddle">
      <static>true</static>
      <pose>8 0 0.05 0 0 0</pose>
      <link name="link">
        <visual name="puddle_vis">
          <geometry><box><size>1.2 0.8 0.02</size></box></geometry>
          <material>
            <ambient>0 0.4 0.9 0.9</ambient>
            <diffuse>0 0.5 1 0.9</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
